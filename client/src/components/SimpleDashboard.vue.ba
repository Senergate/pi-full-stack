
<CurrentCard
  :currents="measuredCurrents"
  :y-range="{ min: 0, max: 100 }"
/>

<PhasorCard
  :voltages="measuredVoltages"
  :angles="_.vuf.sourceAngle"
/>

<VufCard :vuf="vufResult.vufPercent" />

<script setup>
import { reactive, computed, watch, onMounted, onUnmounted } from 'vue';

import App from '../App.js';
import Card from './Card.vue';
import DiscoveredDevicesCard from './DiscoveredDevicesCard.vue';
import PhasorCalculator from './PhasorCalculator.js';

const PHASES = [
  { key: 'a', label: 'L1' },
  { key: 'b', label: 'L2' },
  { key: 'c', label: 'L3' },
];

/*
 * ------------------------------------------------------------
 * DIGITAL TWIN SCENARIOS
 * ------------------------------------------------------------
 *
 * Voltage magnitudes come from the Shelly.
 *
 * The scenario therefore controls only values that we currently
 * do not measure:
 *
 * - phase angle
 * - R
 * - X
 */

const scenarios = {
  ideal: {
    label: 'Ideal',

    angle: {
      a: 0,
      b: -120,
      c: 120,
    },

    resistance: {
      a: 0.05,
      b: 0.05,
      c: 0.05,
    },

    reactance: {
      a: 0.02,
      b: 0.02,
      c: 0.02,
    },
  },

  realistic: {
    label: 'Realistic',

    angle: {
      a: 0,
      b: -120.2,
      c: 119.8,
    },

    resistance: {
      a: 0.08,
      b: 0.08,
      c: 0.08,
    },

    reactance: {
      a: 0.03,
      b: 0.03,
      c: 0.03,
    },
  },
};

/*
 * ------------------------------------------------------------
 * SENERGATE CONTROLLER CONFIGURATION
 * ------------------------------------------------------------
 */

const TARGET_VUF = .1;

/*
 * Avoid actuator changes for negligible predicted improvements.
 */
const MIN_VUF_IMPROVEMENT = 0.05;

/*
 * Estimated current contributions of the controllable devices.
 *
 * These are prototype model parameters and should eventually be
 * calibrated against the real setup.
 *
 * Current phase mapping used here:
 *
 * Heat pump     -> L1
 * Wallbox R0/R1 -> L2
 * Battery       -> L3
 */

const HEATPUMP_MAX_CURRENT = 35;

const WALLBOX_R0_CURRENT = 16;
const WALLBOX_R1_CURRENT = 16;

const BATTERY_DISCHARGE_CURRENT = 20;

/*
 * Candidate heat-pump operating points.
 *
 * The current client represents heat-pump load as a normalized
 * value, therefore the optimizer evaluates a few discrete levels.
 */

const HEATPUMP_STATES = [0, 0.25, 0.5, 0.75, 1];

const BOOLEAN_STATES = [false, true];

/*
 * ------------------------------------------------------------
 * ROOT STATE
 * ------------------------------------------------------------
 */

const _ = reactive({
  count: 0,

  heatpump: {
    load: 0,
  },

  wallbox: {
    load: -1,
    r0: null,
    r1: null,
  },

  battery: {
    load: 0.8,
    discharging: false,
  },

  energy_meter: {
    timedelta: null,
    lastUpdate: null,
    data: {},
  },

  vuf: {
    scenario: 'realistic',

    sourceAngle: {
      a: 0,
      b: -120,
      c: 120,
    },

    resistance: {
      a: 0.05,
      b: 0.05,
      c: 0.05,
    },

    reactance: {
      a: 0.02,
      b: 0.02,
      c: 0.02,
    },
  },

  /*
   * Automatic stabilizer.
   */
  senergate: {
    enabled: false,

    intervalMs: 2000,
    lastPredictionAt: 0,

    currentVuf: null,
    predictedVuf: null,

    lastAction: null,
  },
});

let animationFrame = null;
let unwatchHeatpump = null;

/*
 * ------------------------------------------------------------
 * HELPERS
 * ------------------------------------------------------------
 */

const numberOrNull = value => {
  if (value === undefined || value === null || value === '') {
    return null;
  }

  const number = Number(value);

  return Number.isFinite(number) ? number : null;
};

const formatNumber = (value, digits = 2) => {
  if (value === null || value === undefined || !Number.isFinite(Number(value))) {
    return '--';
  }

  return Number(value).toFixed(digits);
};

/*
 * ------------------------------------------------------------
 * SCENARIO SELECTION
 * ------------------------------------------------------------
 */

const selectScenario = key => {
  const scenario = scenarios[key];

  if (!scenario) {
    return;
  }

  _.vuf.scenario = key;

  Object.assign(_.vuf.sourceAngle, scenario.angle);

  Object.assign(_.vuf.resistance, scenario.resistance);

  Object.assign(_.vuf.reactance, scenario.reactance);
};

/*
 * ------------------------------------------------------------
 * MEASURED VALUES
 * ------------------------------------------------------------
 */

const measuredCurrents = computed(() => ({
  a: numberOrNull(_.energy_meter.data.a_current) ?? 0,

  b: numberOrNull(_.energy_meter.data.b_current) ?? 0,

  c: numberOrNull(_.energy_meter.data.c_current) ?? 0,
}));

const measuredPowerFactors = computed(() => ({
  a: numberOrNull(_.energy_meter.data.a_pf) ?? 1,

  b: numberOrNull(_.energy_meter.data.b_pf) ?? 1,

  c: numberOrNull(_.energy_meter.data.c_pf) ?? 1,
}));

const measuredVoltages = computed(() => ({
  a: numberOrNull(_.energy_meter.data.a_voltage) ?? 230,

  b: numberOrNull(_.energy_meter.data.b_voltage) ?? 230,

  c: numberOrNull(_.energy_meter.data.c_voltage) ?? 230,
}));

/*
 * ------------------------------------------------------------
 * VUF CALCULATION
 * ------------------------------------------------------------
 */

const vufResult = computed(() =>
  PhasorCalculator.analyzeVUF({
    currents: measuredCurrents.value,

    powerFactors: measuredPowerFactors.value,

    sourceVoltages: measuredVoltages.value,

    sourceAngles: _.vuf.sourceAngle,

    resistance: _.vuf.resistance,

    reactance: _.vuf.reactance,
  })
);

const vufStatus = computed(() => {
  const value = vufResult.value.vufPercent;

  if (value === null || !Number.isFinite(value)) {
    return {
      label: 'UNKNOWN',
      color: 'grey',
    };
  }

  if (value < 1) {
    return {
      label: 'GREEN',
      color: 'positive',
    };
  }

  if (value <= 2) {
    return {
      label: 'YELLOW',
      color: 'warning',
    };
  }

  return {
    label: 'RED',
    color: 'negative',
  };
});

/*
 * ------------------------------------------------------------
 * ENERGY METER
 * ------------------------------------------------------------
 *
 * Temporary prototype scaling / correction is intentionally
 * preserved exactly here.
 */

const onEnergyMeter = data => {
  data.a_current -= 0.24;
  data.b_current -= 0.19;
  data.c_current -= 0.13;


  data.a_pf = 1;
  data.b_pf = 1;
  data.c_pf = 1;

  data.a_current = Math.min(Math.max(0, data.a_current), 45);
  data.b_current = Math.min(Math.max(0, data.b_current), 45);
  data.c_current = Math.min(Math.max(0, data.c_current), 45);

  data.a_current *= 800;

  data.b_current *= 400;

  data.c_current *= 230;

  if (_.vuf.scenario === 'realistic') {
    data.b_voltage += -1;
    data.a_voltage += 1;
    data.c_voltage += 0.5;
  }

  Object.assign(_.energy_meter.data, data);

  _.energy_meter.lastUpdate = performance.now();
};

/*
 * ------------------------------------------------------------
 * DEVICE HANDLERS
 * ------------------------------------------------------------
 */

const onWallbox = data => {
  if (data.id === 0) {
    _.wallbox.r0 = data.output;
  } else {
    _.wallbox.r1 = data.output;
  }

  _.wallbox.load = (_.wallbox.r0 ? 1 : 0) + (_.wallbox.r1 ? 2 : 0);
};

const onBattery = data => {
  console.log(data)
  _.battery.discharging = data.output;
};

const toggleWallbox = r => {
  if (r === 0) {
    if (_.wallbox.r0 === null) {
      return;
    }

    const state = !_.wallbox.r0;

    _.wallbox.r0 = null;

    App.WallboxService.set(0, state);
  } else {
    if (_.wallbox.r1 === null) {
      return;
    }

    const state = !_.wallbox.r1;

    _.wallbox.r1 = null;

    App.WallboxService.set(1, state);
  }
};

const updateHeatpumpLoad = value => {
  _.heatpump.load = value;
};

const updateCount = value => {
  _.count = value;
};

/*
 * ------------------------------------------------------------
 * SENERGATE VUF PREDICTOR
 * ------------------------------------------------------------
 *
 * This function reads all required data from the reactive state.
 *
 * It evaluates all candidate combinations of:
 *
 * heat pump
 * wallbox relay 0
 * wallbox relay 1
 * battery discharge
 *
 * and returns the state with the lowest predicted VUF.
 */

const predictSenergateState = () => {
  const currentState = {
    heatpump:
      Number(_.heatpump.load) || 0,

    wallboxR0:
      _.wallbox.r0 === true,

    wallboxR1:
      _.wallbox.r1 === true,

    batteryDischarging:
      _.battery.discharging === true,
  };


  /*
   * ----------------------------------------------------------
   * ACTIVE DEVICE CONSTRAINTS
   * ----------------------------------------------------------
   *
   * If a device is currently active, Senergate may NOT turn it
   * off. It may only reduce / redistribute its controllable load.
   *
   * Devices that are currently inactive remain inactive.
   */

  const heatpumpIsActive =
    currentState.heatpump > 0;

  const wallboxR0IsActive =
    currentState.wallboxR0;

  const wallboxR1IsActive =
    currentState.wallboxR1;

  const batteryIsActive =
    currentState.batteryDischarging;


  /*
   * ----------------------------------------------------------
   * LOAD LEVELS
   * ----------------------------------------------------------
   *
   * Active devices may be throttled, but not disabled.
   *
   * The minimum active level can be tuned for the real devices.
   */

  const MIN_ACTIVE_LOAD = 0.25;

  const heatpumpStates =
    heatpumpIsActive
      ? [
          MIN_ACTIVE_LOAD,
          0.5,
          0.75,
          1,
        ]
      : [0];


  /*
   * Wallbox relays are binary in the current prototype.
   *
   * If they are ON, they stay ON.
   * If they are OFF, they stay OFF.
   *
   * If later you can control wallbox charging current, replace
   * these booleans with actual load levels.
   */

  const wallboxR0States =
    wallboxR0IsActive
      ? [true]
      : [false];

  const wallboxR1States =
    wallboxR1IsActive
      ? [true]
      : [false];


  /*
   * Same rule for the battery.
   *
   * Current interface is binary, so if discharging is active,
   * it remains active.
   */

  const batteryStates =
    batteryIsActive
      ? [true]
      : [false];


  /*
   * ----------------------------------------------------------
   * ESTIMATE CURRENTS
   * ----------------------------------------------------------
   */

  const predictCurrents = candidate => {
    const currents = {
      ...measuredCurrents.value,
    };


    /*
     * Heat pump -> L1
     */

    const currentHeatpumpCurrent =
      currentState.heatpump *
      HEATPUMP_MAX_CURRENT;

    const candidateHeatpumpCurrent =
      candidate.heatpump *
      HEATPUMP_MAX_CURRENT;

    currents.a +=
      candidateHeatpumpCurrent -
      currentHeatpumpCurrent;


    /*
     * Wallbox -> L2
     */

    const currentWallboxCurrent =
      (
        currentState.wallboxR0
          ? WALLBOX_R0_CURRENT
          : 0
      ) +
      (
        currentState.wallboxR1
          ? WALLBOX_R1_CURRENT
          : 0
      );

    const candidateWallboxCurrent =
      (
        candidate.wallboxR0
          ? WALLBOX_R0_CURRENT
          : 0
      ) +
      (
        candidate.wallboxR1
          ? WALLBOX_R1_CURRENT
          : 0
      );

    currents.b +=
      candidateWallboxCurrent -
      currentWallboxCurrent;


    /*
     * Battery -> L3
     */

    const currentBatteryCurrent =
      currentState.batteryDischarging
        ? -BATTERY_DISCHARGE_CURRENT
        : 0;

    const candidateBatteryCurrent =
      candidate.batteryDischarging
        ? -BATTERY_DISCHARGE_CURRENT
        : 0;

    currents.c +=
      candidateBatteryCurrent -
      currentBatteryCurrent;


    currents.a =
      Math.max(0, currents.a);

    currents.b =
      Math.max(0, currents.b);

    currents.c =
      Math.max(0, currents.c);


    return currents;
  };


  /*
   * ----------------------------------------------------------
   * SEARCH
   * ----------------------------------------------------------
   */

  let best = null;


  for (
    const heatpump
    of heatpumpStates
  ) {
    for (
      const wallboxR0
      of wallboxR0States
    ) {
      for (
        const wallboxR1
        of wallboxR1States
      ) {
        for (
          const batteryDischarging
          of batteryStates
        ) {

          const candidate = {
            heatpump,
            wallboxR0,
            wallboxR1,
            batteryDischarging,
          };


          const currents =
            predictCurrents(
              candidate
            );


          const result =
            PhasorCalculator.analyzeVUF({
              currents,

              powerFactors:
                measuredPowerFactors.value,

              sourceVoltages:
                measuredVoltages.value,

              sourceAngles:
                _.vuf.sourceAngle,

              resistance:
                _.vuf.resistance,

              reactance:
                _.vuf.reactance,
            });


          if (
            result.vufPercent === null ||
            !Number.isFinite(
              result.vufPercent
            )
          ) {
            continue;
          }


          /*
           * --------------------------------------------------
           * TOTAL ACTIVE LOAD
           * --------------------------------------------------
           *
           * This is only a relative score.
           *
           * Larger = more useful load retained.
           */

          const totalLoad =
            candidate.heatpump *
              HEATPUMP_MAX_CURRENT +

            (
              candidate.wallboxR0
                ? WALLBOX_R0_CURRENT
                : 0
            ) +

            (
              candidate.wallboxR1
                ? WALLBOX_R1_CURRENT
                : 0
            ) +

            (
              candidate.batteryDischarging
                ? BATTERY_DISCHARGE_CURRENT
                : 0
            );


          /*
           * --------------------------------------------------
           * SELECTION LOGIC
           * --------------------------------------------------
           *
           * 1. Prefer lower VUF.
           *
           * 2. If two candidates have practically the same VUF,
           *    prefer the one with the larger retained load.
           */

          const VUF_TOLERANCE =
            0.05;


          if (best === null) {
            best = {
              state:
                candidate,

              currents,

              vuf:
                result.vufPercent,

              totalLoad,
            };

            continue;
          }


          const clearlyBetterVuf =
            result.vufPercent <
            best.vuf -
              VUF_TOLERANCE;


          const similarVuf =
            Math.abs(
              result.vufPercent -
              best.vuf
            ) <=
            VUF_TOLERANCE;


          const higherLoad =
            totalLoad >
            best.totalLoad;


          if (
            clearlyBetterVuf ||
            (
              similarVuf &&
              higherLoad
            )
          ) {
            best = {
              state:
                candidate,

              currents,

              vuf:
                result.vufPercent,

              totalLoad,
            };
          }
        }
      }
    }
  }


  return best;
};

/*
 * ------------------------------------------------------------
 * APPLY PREDICTED STATE
 * ------------------------------------------------------------
 */

const applySenergateState = prediction => {
  if (!prediction) {
    return;
  }

  const state = prediction.state;

  /*
   * ----------------------------------------------------------
   * HEAT PUMP
   * ----------------------------------------------------------
   *
   * The existing watcher will send the actual backend command.
   */

  if (_.heatpump.load !== state.heatpump) {
    _.heatpump.load = state.heatpump;
  }

  /*
   * ----------------------------------------------------------
   * WALLBOX RELAY 0
   * ----------------------------------------------------------
   */

  if (_.wallbox.r0 !== null && _.wallbox.r0 !== state.wallboxR0) {
    _.wallbox.r0 = null;

    App.WallboxService.set(0, state.wallboxR0);
  }

  /*
   * ----------------------------------------------------------
   * WALLBOX RELAY 1
   * ----------------------------------------------------------
   */

  if (_.wallbox.r1 !== null && _.wallbox.r1 !== state.wallboxR1) {
    _.wallbox.r1 = null;

    App.WallboxService.set(1, state.wallboxR1);
  }

  /*
   * ----------------------------------------------------------
   * BATTERY
   * ----------------------------------------------------------
   *
   * BatteryService uses inverted setter semantics.
   *
   * Do not manually overwrite _.battery.discharging here.
   * We wait for onBattery() to report the actual new state.
   */

  if (_.battery.discharging !== state.batteryDischarging) {
    App.BatteryService.set(!state.batteryDischarging);
  }

  _.senergate.predictedVuf = prediction.vuf;

  _.senergate.lastAction = {
    heatpump: state.heatpump,

    wallboxR0: state.wallboxR0,

    wallboxR1: state.wallboxR1,

    batteryDischarging: state.batteryDischarging,

    predictedCurrents: {
      ...prediction.currents,
    },
  };
};

/*
 * ------------------------------------------------------------
 * SENERGATE ENABLE / DISABLE
 * ------------------------------------------------------------
 *
 * Setting the prediction time to zero causes an immediate
 * evaluation when Senergate is enabled.
 */

watch(
  () => _.senergate.enabled,

  enabled => {
    if (enabled) {
      _.senergate.lastPredictionAt = 0;
    }
  }
);

/*
 * ------------------------------------------------------------
 * UPDATE / CONTROL LOOP
 * ------------------------------------------------------------
 */

const animate = () => {
  const now = performance.now();

  /*
   * Measurement age.
   */

  if (_.energy_meter.lastUpdate) {
    _.energy_meter.timedelta = (now - _.energy_meter.lastUpdate) / 1000;
  }

  /*
   * ----------------------------------------------------------
   * SENERGATE CONTROL LOOP
   * ----------------------------------------------------------
   */

  const currentVuf = vufResult.value.vufPercent;

  _.senergate.currentVuf = currentVuf;

  if (
    _.senergate.enabled &&
    currentVuf !== null &&
    Number.isFinite(currentVuf) &&
    currentVuf > TARGET_VUF &&
    now - _.senergate.lastPredictionAt >= _.senergate.intervalMs
  ) {
    /*
     * Record the time before calculating so that this iteration
     * cannot run twice.
     */

    _.senergate.lastPredictionAt = now;

    const prediction = predictSenergateState();
    console.log(prediction)

    if (prediction && prediction.vuf < currentVuf - MIN_VUF_IMPROVEMENT) {
      applySenergateState(prediction);
    }
  }

  animationFrame = requestAnimationFrame(animate);
};

/*
 * ------------------------------------------------------------
 * LIFECYCLE
 * ------------------------------------------------------------
 */

const init = () => {
  animationFrame = requestAnimationFrame(animate);

  unwatchHeatpump = watch(
    () => _.heatpump.load,

    value => {
      App.EspService.heatpump(value);
    }
  );

  App.EnergyMeterService.on('data', onEnergyMeter);

  App.WallboxService.on('data', onWallbox);

  App.BatteryService.on('data', onBattery);

  App.WallboxService.requestUpdate();
  App.BatteryService.requestUpdate();

  /*
   * Initial Digital Twin scenario.
   */

  selectScenario('realistic');
};

onMounted(init);

onUnmounted(() => {
  if (animationFrame) {
    cancelAnimationFrame(animationFrame);
  }

  unwatchHeatpump?.();

  App.EnergyMeterService.off?.('data', onEnergyMeter);

  App.WallboxService.off?.('data', onWallbox);

  App.BatteryService.off?.('data', onBattery);
});
</script>

<template>
  <div class="container">
    <!-- ======================================================
         HEADER
         ====================================================== -->

    <div class="row" style="margin: 0 0 1em 0">
      <div class="col-12">
        <div class="row items-center justify-between">
          <div class="title">SENERGATE</div>

          <!-- ==================================================
               SENERGATE STABILIZER TOGGLE
               ================================================== -->

          <div class="row items-center q-gutter-sm">
            <span class="text-caption text-grey-5"> VUF Stabilizer </span>

            <q-toggle
              v-model="_.senergate.enabled"
              color="positive"
              checked-icon="bolt"
              unchecked-icon="
                power_settings_new
              "
            />

            <q-chip dense :color="_.senergate.enabled ? 'positive' : 'grey-8'" text-color="white">
              {{ _.senergate.enabled ? 'ON' : 'OFF' }}
            </q-chip>
          </div>
        </div>
      </div>
    </div>

    <!-- ======================================================
         ROW 1
         DEVICES
         ====================================================== -->

    <div class="row q-col-gutter-md">
      <div class="col-12">
        <DiscoveredDevicesCard
          :root="_"
          @update:heatpump-load="updateHeatpumpLoad"
          @update:count="updateCount"
          @toggle-wallbox="toggleWallbox"
        />
      </div>
    </div>

    <!-- ======================================================
         ROW 2
         VUF INPUTS
         ====================================================== -->

    <div class="row q-col-gutter-md q-mt-md">
      <div class="col-12">
        <Card>
          <!-- ==================================================
               CARD HEADER
               ================================================== -->

          <q-card-section class="q-pb-sm">
            <div class="row items-center justify-between">
              <div>
                <div class="text-h6 text-spaced">VUF INPUTS</div>

                <div class="text-caption text-grey-5">Measured + Digital Twin assumptions</div>
              </div>

              <!-- ==============================================
                   SCENARIO BUTTONS
                   ============================================== -->

              <div class="scenario-buttons">
                <q-btn
                  rounded
                  dense
                  no-caps
                  padding="5px 16px"
                  color="primary"
                  label="Ideal"
                  :outline="_.vuf.scenario !== 'ideal'"
                  :unelevated="_.vuf.scenario === 'ideal'"
                  @click="selectScenario('ideal')"
                />

                <q-btn
                  rounded
                  dense
                  no-caps
                  padding="5px 16px"
                  color="primary"
                  label="Realistic"
                  :outline="_.vuf.scenario !== 'realistic'"
                  :unelevated="_.vuf.scenario === 'realistic'"
                  @click="selectScenario('realistic')"
                />
              </div>
            </div>
          </q-card-section>

          <q-separator />

          <!-- ==================================================
               INPUT TABLE
               ================================================== -->

          <q-card-section class="q-pa-sm">
            <!-- ================================================
                 GROUP HEADER
                 ================================================ -->

            <div class="input-grid group-header">
              <div></div>

              <div class="measured-group">MEASURED</div>

              <div class="simulated-group">SIMULATED</div>
            </div>

            <!-- ================================================
                 COLUMN HEADER
                 ================================================ -->

            <div class="input-grid column-header">
              <div>Phase</div>

              <div>I</div>

              <div>PF</div>

              <div>Voltage</div>

              <div>Angle</div>

              <div>R</div>

              <div>X</div>
            </div>

            <!-- ================================================
                 PHASE ROWS
                 ================================================ -->

            <div v-for="phase in PHASES" :key="phase.key" class="input-grid input-row">
              <!-- PHASE -->

              <div class="phase-label">
                {{ phase.label }}
              </div>

              <!-- CURRENT -->

              <div>
                <strong>
                  {{ formatNumber(measuredCurrents[phase.key], 2) }}
                </strong>

                <span class="unit"> A </span>
              </div>

              <!-- PF -->

              <div>
                <strong>
                  {{ formatNumber(measuredPowerFactors[phase.key], 3) }}
                </strong>
              </div>

              <!-- VOLTAGE -->

              <div>
                <strong>
                  {{ formatNumber(measuredVoltages[phase.key], 1) }}
                </strong>

                <span class="unit"> V </span>
              </div>

              <!-- ANGLE -->

              <div>
                <strong>
                  {{ formatNumber(_.vuf.sourceAngle[phase.key], 1) }}
                </strong>

                <span class="unit"> ° </span>
              </div>

              <!-- R -->

              <div>
                <strong>
                  {{ formatNumber(_.vuf.resistance[phase.key], 3) }}
                </strong>

                <span class="unit"> Ω </span>
              </div>

              <!-- X -->

              <div>
                <strong>
                  {{ formatNumber(_.vuf.reactance[phase.key], 3) }}
                </strong>

                <span class="unit"> Ω </span>
              </div>
            </div>
          </q-card-section>

          <q-separator />

          <q-card-section class="q-py-xs text-caption text-grey-5">
            Measurement age:
            {{ _.energy_meter.timedelta ? `${_.energy_meter.timedelta.toFixed(1)} s` : '--' }}
          </q-card-section>
        </Card>
      </div>
    </div>

    <!-- ======================================================
         ROW 3
         COMPUTED VUF
         ====================================================== -->

    <div class="row q-col-gutter-md q-mt-md">
      <div class="col-12">
        <Card>
          <q-card-section>
            <div class="row items-center justify-between">
              <div class="text-h6 text-spaced">CALCULATED</div>

              <div v-if="_.senergate.enabled" class="text-caption text-grey-5">
                Target VUF &lt;
                {{ TARGET_VUF.toFixed(1) }}%
              </div>
            </div>
          </q-card-section>

          <q-separator />

          <!-- ==================================================
               VUF
               ================================================== -->

          <q-card-section class="text-center">
            <div class="text-overline text-grey-5">SIMULATED VUF</div>

            <div class="vuf-value">
              {{ vufResult.vufPercent === null ? '--' : formatNumber(vufResult.vufPercent, 3) }}%
            </div>


            <!-- ================================================
                 SENERGATE PREDICTION
                 ================================================ -->

            <div v-if="_.senergate.enabled && _.senergate.predictedVuf !== null" class="stabilizer-result q-mt-md">
              <span class="text-grey-5"> Last predicted VUF: </span>

              <strong> {{ formatNumber(_.senergate.predictedVuf, 3) }}% </strong>
            </div>
          </q-card-section>

          <q-separator />

          <!-- ==================================================
               CALCULATED INTERNAL VALUES
               ================================================== -->

          <q-card-section>
            <div class="row q-col-gutter-md text-center">
              <!-- LOAD VOLTAGES -->

              <div v-for="phase in PHASES" :key="phase.key" class="col-6 col-md-2">
                <div class="calculated-label">V{{ phase.label }}</div>

                <div class="calculated-value">
                  {{ formatNumber(vufResult.loadVoltageMagnitudes?.[phase.key], 2) }}
                  V
                </div>
              </div>

              <!-- V1 -->

              <div class="col-6 col-md-2">
                <div class="calculated-label">V1</div>

                <div class="calculated-value">
                  {{ formatNumber(vufResult.positiveSequenceMagnitude, 2) }}
                  V
                </div>
              </div>

              <!-- V2 -->

              <div class="col-6 col-md-2">
                <div class="calculated-label">V2</div>

                <div class="calculated-value">
                  {{ formatNumber(vufResult.negativeSequenceMagnitude, 2) }}
                  V
                </div>
              </div>

              <!-- VUF -->

              <div class="col-6 col-md-2">
                <div class="calculated-label">VUF</div>

                <div class="calculated-value">
                  {{ vufResult.vufPercent === null ? '--' : formatNumber(vufResult.vufPercent, 3) }}%
                </div>
              </div>
            </div>
          </q-card-section>
        </Card>
      </div>
    </div>
  </div>
</template>

